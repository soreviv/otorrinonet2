# npm 12+ bloquea por defecto instalar dependencias declaradas como URL de
# tarball directa (allow-remote=none). "xlsx" en package.json usa ese patrón
# a propósito (paquete de npm desactualizado; SheetJS recomienda instalar
# la versión reciente directo desde su CDN). "root" solo permite URLs
# declaradas en package.json, no en dependencias transitivas.
allow-remote=root
