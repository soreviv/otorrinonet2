generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model StaffUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  role               String    @default("medico")
  activo             Boolean   @default(true)
  passwordHash       String
  especialidad       String?
  cedula             String?
  cedulaEspecialidad String?
  universidad        String?
  logoUniversidadUrl String?
  totpSecret         String?
  totpEnabled        Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  sessionVersion     Int       @default(0)
  lastAccess         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  auditLogs           AuditLog[]
  fhirExports         FhirExport[]
  medicalNotes        MedicalNote[]
  prescriptions       Prescription[]
  labOrders           LabOrder[]
  passwordResetTokens PasswordResetToken[]

  @@map("staff_users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─── Pacientes — NOM-004-SSA3-2012 ────────────────────────────────────────────

model Patient {
  id               String   @id @default(cuid())
  expedienteNumber String   @unique
  nombre           String
  apellidoPaterno  String
  apellidoMaterno  String?
  curp             String?
  fechaNacimiento  DateTime
  sexo             String
  grupoSanguineo   String?
  telefono         String?
  email            String?
  direccion        String?
  ocupacion        String?
  estadoCivil      String?
  escolaridad      String?
  religion         String?
  lugarNacimiento  String?
  antecedentesHeredoFamiliares        String?
  antecedentesPersonalesPatologicos   String?
  antecedentesPersonalesNoPatologicos String?
  antecedentesGinecoObstetricos       String?
  alergias                            String[]
  contactoEmergencia                  String?
  telefonoEmergencia                  String?
  rfc               String?
  razonSocialFiscal String?
  regimenFiscal     String?
  cpFiscal          String?
  usoCfdi           String?  @default("D01")

  status           String   @default("activo")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  appointments    Appointment[]
  medicalNotes    MedicalNote[]
  prescriptions   Prescription[]
  patientConsents PatientConsent[]
  arcoRequests    ArcoRequest[]
  fhirExports     FhirExport[]
  vitals          Vitals[]
  labOrders       LabOrder[]

  @@index([apellidoPaterno])
  @@index([nombre])
  @@map("patients")
}

// ─── Agenda ───────────────────────────────────────────────────────────────────

model Service {
  id           String   @id @default(cuid())
  name         String
  description  String?
  durationMins Int      @default(30)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  appointments Appointment[]

  @@map("services")
}

model Appointment {
  id               String    @id @default(cuid())
  patientId        String?
  medicoId         String?
  serviceId        String?
  scheduledAt      DateTime
  status           String    @default("pendiente")
  notes            String?
  bookingSource    String    @default("staff")
  patientName      String?
  patientEmail     String?
  patientPhone     String?
  appointmentType  String?
  actionToken      String?   @unique
  patientConfirmed Boolean   @default(false)
  reminderSent     Boolean   @default(false)
  npsSentAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])
  cobro   Cobro?

  @@index([scheduledAt])
  @@map("appointments")
}

// ─── CIE-10 ───────────────────────────────────────────────────────────────────

model Cie10 {
  codigo      String  @id
  descripcion String
  categoria   String?

  medicalNoteDiagnoses MedicalNoteDiagnosis[]

  @@map("cie10_catalog")
}

// ─── Vitales ──────────────────────────────────────────────────────────────────

model Vitals {
  id                     String   @id @default(cuid())
  patientId              String
  fecha                  DateTime @default(now())
  presionSistolica       Int?
  presionDiastolica      Int?
  frecuenciaCardiaca     Int?
  frecuenciaRespiratoria Int?
  temperatura            Float?
  saturacionOxigeno      Int?
  peso                   Float?
  talla                  Float?
  glucosa                Int?
  registradoPorId        String?
  createdAt              DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("vitals")
}

// ─── Notas Médicas — NOM-004-SSA3-2012 ───────────────────────────────────────

model MedicalNote {
  id        String   @id @default(cuid())
  patientId String
  medicoId  String
  tipo      String
  subtipo   String?
  fecha     DateTime @default(now())
  motivoConsulta               String?
  padecimientoActual           String?
  habitusExterior              String?
  exploracionFisica            String?
  signosVitalesTexto           String?
  subjetivo                    String?
  objetivo                     String?
  analisis                     String?
  plan                         String?
  pronostico                   String?
  indicacionTerapeutica        String?
  planEstudios                 String?
  diagnosticoPreoperatorio     String?
  operacionPlaneada            String?
  operacionRealizada           String?
  diagnosticoPostoperatorio    String?
  descripcionTecnicaQuirurgica String?
  hallazgosTransoperatorios    String?
  complicaciones               String?
  sangradoAproximado           String?
  firmada      Boolean   @default(false)
  firmaHash    String?
  fechaFirma   DateTime?
  firmaUserId  String?
  createdAt    DateTime  @default(now())

  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medico    StaffUser @relation(fields: [medicoId], references: [id])
  diagnoses MedicalNoteDiagnosis[]
  addendums MedicalNoteAddendum[]

  @@index([patientId])
  @@index([fecha])
  @@map("medical_notes")
}

model MedicalNoteAddendum {
  id        String   @id @default(cuid())
  noteId    String
  contenido String
  authorId  String?
  firmaHash String?
  fecha     DateTime @default(now())
  createdAt DateTime @default(now())

  note MedicalNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("medical_note_addendums")
}

model MedicalNoteDiagnosis {
  id              String   @id @default(cuid())
  noteId          String
  cie10Codigo     String
  tipoDiagnostico String   @default("presuntivo")
  createdAt       DateTime @default(now())

  note  MedicalNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  cie10 Cie10       @relation(fields: [cie10Codigo], references: [codigo])

  @@map("medical_note_diagnoses")
}

// ─── Recetas — un registro por medicamento ────────────────────────────────────

model Prescription {
  id                     String    @id @default(cuid())
  recetaId               String
  patientId              String
  medicoId               String
  medicamento            String
  nombreComercial        String?
  presentacion           String?
  dosis                  String
  via                    String?
  frecuencia             String
  duracion               String?
  indicaciones           String?
  instruccionesGenerales String?
  status                 String    @default("activa")
  firmada                Boolean   @default(false)
  firmaHash              String?
  firmaImagen            String?
  fechaFirma             DateTime?
  firmaUserId            String?
  createdAt              DateTime  @default(now())

  patient Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medico  StaffUser @relation(fields: [medicoId], references: [id])

  @@index([recetaId])
  @@index([patientId])
  @@map("prescriptions")
}

// ─── Consentimientos — NOM-004 ────────────────────────────────────────────────

model PatientConsent {
  id                      String    @id @default(cuid())
  patientId               String
  medicoId                String?
  tipoConsentimiento      String
  version                 String    @default("1.0")
  procedimiento           String?
  riesgos                 String?
  beneficios              String?
  alternativas            String?
  consentTexto            String?
  autorizaContingencias   Boolean   @default(true)
  nombreFirmante          String?
  parentescoRepresentante String?
  nombreTestigo1          String?
  nombreTestigo2          String?
  aceptado                Boolean   @default(false)
  fechaAceptacion         DateTime?
  lugarFirma              String?
  ipAddress               String?
  createdAt               DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_consents")
}

// ─── Órdenes de Laboratorio ───────────────────────────────────────────────────

model LabOrder {
  id                    String    @id @default(cuid())
  patientId             String
  medicoId              String
  estudios              String[]
  diagnosticoPresuntivo String?
  indicacionesClinicas  String?
  urgente               Boolean   @default(false)
  ayuno                 Boolean   @default(false)
  status                String    @default("pendiente")
  resultados            String?
  fechaResultados       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  patient Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medico  StaffUser @relation(fields: [medicoId], references: [id])

  @@index([patientId])
  @@map("lab_orders")
}

// ─── Auditoría — NOM-024-SSA3-2012 ───────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  accion    String
  entidad   String
  entidadId String?
  detalles  String?
  ipAddress String?
  userAgent String?
  fecha     DateTime @default(now())

  user StaffUser? @relation(fields: [userId], references: [id])

  @@index([fecha])
  @@map("audit_logs")
}

// ─── Configuración ────────────────────────────────────────────────────────────

model ClinicConfig {
  id                     String   @id @default("singleton")
  clinicName             String   @default("Clínica ORL Viveros")
  clinicAddress          String?
  clinicPhone            String?
  clinicEmail            String?
  clinicCofepris         String?
  clinicLogoUrl          String?  @db.Text
  doctorName             String   @default("Dr. Alejandro Viveros Domínguez")
  doctorLicense          String?
  doctorSpecialtyLicense String?
  doctorUniversity       String?
  doctorUniversityLogoUrl String? @db.Text
  portalEnabled          Boolean  @default(false)
  portalTitle            String?
  portalTagline          String?
  appointmentDurationMin Int      @default(30)
  bookingAdvanceDays     Int      @default(30)
  bookingBufferMin       Int      @default(0)
  horarios               Json?
  diasFeriados           Json?
  notificationEmail      String?
  googleReviewsJson      Json?
  googleReviewsCachedAt  DateTime?
  updatedAt              DateTime @updatedAt

  @@map("clinic_config")
}

// ─── Mensajes de Contacto ─────────────────────────────────────────────────────

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  read      Boolean   @default(false)
  repliedAt DateTime?
  createdAt DateTime  @default(now())

  @@map("contact_messages")
}

// ─── ARCO / FHIR ─────────────────────────────────────────────────────────────

model ArcoRequest {
  id          String    @id @default(cuid())
  type        String
  patientId   String
  description String
  status      String    @default("pendiente")
  notes       String?
  submittedAt DateTime  @default(now())
  resolvedAt  DateTime?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("arco_requests")
}

model FhirExport {
  id            String    @id @default(cuid())
  type          String
  patientId     String?
  dateRangeFrom DateTime?
  dateRangeTo   DateTime?
  requestedById String
  status        String    @default("en_proceso")
  fileSize      String?
  requestedAt   DateTime  @default(now())
  completedAt   DateTime?

  patient     Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  requestedBy StaffUser @relation(fields: [requestedById], references: [id])

  @@map("fhir_exports")
}

// ─── Cobros ───────────────────────────────────────────────────────────────────

model Cobro {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  tipoConsulta  String   // "primera_vez" | "subsecuente" | "lavado_oidos" | "otro"
  montoTotal    Int      // centavos MXN (110000 = $1,100.00)
  notasExtra    String?
  metodoPago    String   // "efectivo" | "tarjeta" | "transferencia"

  facturado     Boolean  @default(false)
  cfdiUid       String?  // UID del CFDI en factura.com
  cfdiUuid      String?  // UUID / folio fiscal SAT

  registradoPor String
  cobradoAt     DateTime @default(now())

  @@map("cobros")
}

enum ProductCategory {
  dispositivo_medico
  suplemento_otc
  paquete_consulta
  vacuna
  otro
}

enum DeliveryMode {
  pickup_only
  shipping_only
  both
}

model Product {
  id             String          @id @default(cuid())
  nombre         String
  descripcion    String?         @db.Text
  slug           String          @unique
  categoria      ProductCategory
  modoEntrega    DeliveryMode    @default(both)
  precioUnitario Int
  stock          Int             @default(0)
  stockIlimitado Boolean         @default(false)
  activo         Boolean         @default(true)
  imagenes       String[]
  metaTitle      String?
  metaDesc       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  orderItems     OrderItem[]
  @@index([categoria])
  @@index([activo])
  @@map("products")
}

enum OrderStatus {
  pendiente_pago
  pagado
  en_preparacion
  enviado
  entregado
  cancelado
  reembolsado
}

enum ShippingChoice {
  pickup
  domicilio
}

model Order {
  id                    String         @id @default(cuid())
  compradorNombre       String
  compradorEmail        String
  compradorTelefono     String?
  direccionCalle        String?
  direccionNumero       String?
  direccionColonia      String?
  direccionMunicipio    String?
  direccionEstado       String?
  direccionCP           String?
  shippingChoice        ShippingChoice
  costoEnvio            Int            @default(0)
  subtotal              Int
  total                 Int
  status                OrderStatus    @default(pendiente_pago)
  stripePaymentIntentId String?        @unique
  stripeChargeId        String?
  guiaMensajeria        String?
  urlRastreo            String?
  notasInternas         String?        @db.Text
  stripeEventId         String?        @unique
  ticketEnviadoAt       DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  items                 OrderItem[]
  @@index([status])
  @@index([compradorEmail])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  cantidad       Int
  precioUnitario Int
  nombreSnapshot String
  subtotal       Int
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id])
  @@index([orderId])
  @@map("order_items")
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
  @@map("stripe_webhook_events")
}

model BlockedPeriod {
  id        Int      @id @default(autoincrement())
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())
}
