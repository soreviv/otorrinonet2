# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/otorrinonet?schema=public"

# JWT session secret (32 random bytes as hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="your-64-char-hex-secret-here"

# Cloudflare Turnstile site key — get yours at dash.cloudflare.com > Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
