# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/otorrinonet?schema=public"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# JWT session secret (32 random bytes as hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="your-64-char-hex-secret-here"

# ─── Cloudflare Turnstile ─────────────────────────────────────────────────────
# Get both keys at https://dash.cloudflare.com > Turnstile
# Use sitekey "1x00000000000000000000AA" and secret "1x0000000000000000000000000000000AA" for local testing
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# Used to send appointment confirmation and clinic notification emails
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@example.com"
SMTP_PASS="your-smtp-password"
# "From" address shown to recipients
SMTP_FROM="Dr. Viveros ORL <noreply@example.com>"
# Clinic inbox that receives new appointment request notifications
CLINIC_EMAIL="consultorio@example.com"

# ─── App ──────────────────────────────────────────────────────────────────────
# Public base URL — used for generating absolute links in emails
NEXT_PUBLIC_APP_URL="https://tudominio.com"
NODE_ENV="production"

# ─── Clinic info (optional — defaults are in src/lib/clinic-config.ts) ────────
# DOCTOR_LICENSE="12345678"
# DOCTOR_SPECIALTY_LICENSE="87654321"
# DOCTOR_UNIVERSITY="UANL"
# CLINIC_ADDRESS="Av. Gonzalitos 123, Monterrey, N.L."
# CLINIC_PHONE="81 8XXX XXXX"
# CLINIC_COFEPRIS="123456789"
