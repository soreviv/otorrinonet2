# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/otorrinonet"

# ── Sesión JWT ────────────────────────────────────────────────────────────────
# Genera con: openssl rand -hex 64
SESSION_SECRET="cambia-esto-en-produccion"

# ── Cifrado columnar AES-256-GCM (CURP, teléfono, email, dirección) ──────────
# Genera con: openssl rand -hex 32
ENCRYPTION_KEY="cambia-esto-en-produccion"
# Genera con: openssl rand -hex 32
ENCRYPTION_KDF_SALT="cambia-esto-en-produccion"

# ── Cloudflare Turnstile ───────────────────────────────────────────────────────
# Obtén las claves en: https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x000000000000000000000000"
TURNSTILE_SECRET_KEY="0x0000000000000000000000000000000000000000"

# ── SMTP (nodemailer) ─────────────────────────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="usuario@example.com"
SMTP_PASS="contraseña-smtp"
SMTP_FROM="Dr. Viveros ORL <noreply@example.com>"

# ── URL pública de la app ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://otorrinonet.com"

# ── Datos del consultorio (seed / fallback) ───────────────────────────────────
# Estos valores se usan como fallback si aún no hay configuración en la BD
CLINIC_NAME="Consultorio Dr. Viveros ORL"
CLINIC_EMAIL="contacto@otorrinonet.com"
CLINIC_PHONE="+52 55 0000 0000"
CLINIC_ADDRESS="Calle, Número, Colonia, Ciudad, CP"
CLINIC_COFEPRIS=""

DOCTOR_NAME="Dr. Alejandro Viveros Domínguez"
DOCTOR_LICENSE=""
DOCTOR_SPECIALTY_LICENSE=""
DOCTOR_UNIVERSITY=""

# ── Seed de usuarios staff (solo para npx prisma db seed) ─────────────────────
# Si no se definen se usa contraseña temporal y mustChangePassword=true
SEED_PASSWORD_MEDICO=""
SEED_PASSWORD_RECEPCIONISTA=""
SEED_PASSWORD_ENFERMERA=""

# ── Google Places API ─────────────────────────────────────────────────────────
# Habilita "Places API (New)" en Google Cloud Console y copia la clave aquí
# Las reseñas se cachean en BD y se refrescan desde el panel de administración
GOOGLE_PLACES_API_KEY=""

# ── Cron secret ───────────────────────────────────────────────────────────────
# Token para proteger /api/cron/nps. Genera con: openssl rand -hex 32
# Úsalo en crontab: curl -H "Authorization: Bearer <secret>" https://otorrinonet.com/api/cron/nps
CRON_SECRET=""

# ── Factura.com (autofacturación CFDI 4.0) ───────────────────────────────────
# Obtén las claves en: https://factura.com → API → Credenciales
FACTURA_COM_API_KEY=""
FACTURA_COM_SECRET_KEY=""
