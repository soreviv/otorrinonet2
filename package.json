{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "chmod -R o+rX .next/",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.10.0",
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.15.0",
    "@tailwindcss/typography": "^0.5.20",
    "bcryptjs": "^3.0.3",
    "critters": "^0.0.23",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "jose": "^6.2.11",
    "lucide-react": "^1.8.0",
    "next": "^16.3.4",
    "nodemailer": "^9.1.1",
    "otplib": "^13.4.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.8.1",
    "stripe": "^22.1.1",
    "zod": "^4.5.4"
  },
  "overrides": {
    "@hono/node-server": ">=2.0.5",
    "postcss": ">=8.5.23",
    "sharp": ">=0.35.0",
    "hono": ">=4.12.34",
    "nanoid": ">=3.3.18",
    "fast-uri": ">=4.1.4",
    "valibot": ">=1.4.2",
    "js-yaml": ">=4.3.1",
    "undici": ">=7.29.0",
    "deepmerge-ts": ">=8.0.0",
    "@typescript-eslint/typescript-estree": {
      "minimatch": {
        "brace-expansion": ">=5.0.9"
      }
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.7",
    "dotenv": "^17.4.2",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "jsdom": "^29.1.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^7",
    "vitest": "^4.1.11",
    "vitest-mock-extended": "^5.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-latest/xlsx-latest.tgz"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true,
    "unrs-resolver": true
  }
}
